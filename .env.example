# ─────────────────────────────────────────────────────────────────────────────
# Study Buddies — environment variables
#
# Copy this file to .env.local and fill in the values. .env.local is
# gitignored; NEVER commit real keys. Where to find each value is noted
# per variable. Full setup walkthrough: SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Your Supabase project's URL.
# It is always https://<project-ref>.supabase.co, and your project ref is
# right there in the dashboard's address bar:
#   supabase.com/dashboard/project/<PROJECT-REF>
# In the UI: the "Connect" button at the top of the dashboard, or
# Settings -> API. (NOT Settings -> API Keys — that page is keys only.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The low-privilege public API key. Safe to expose to browsers BY DESIGN —
# row-level security is what protects the data, not this key's secrecy.
# Dashboard -> Settings -> API Keys. Supabase now issues "publishable"
# keys (sb_publishable_...); the older "anon" JWT lives under the
# "Legacy API Keys" tab. EITHER works here — they map to the same Postgres
# role. Prefer the publishable key: legacy keys are deprecated end of 2026.
# (The variable keeps its ANON name so we don't churn every import site.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Where this app is served. Used to build auth redirect links (email
# confirmations, OAuth callbacks) — must match EXACTLY what you register
# in the Supabase auth settings and Google OAuth client.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Required for admin scripts only (server-side, NEVER public) ─────────────

# The elevated key that BYPASSES row-level security. Only the CSV course
# import script (scripts/import-courses.ts) uses it. Never prefix it with
# NEXT_PUBLIC_, never import it into client code, never commit it, never
# add it to Vercel.
# Dashboard -> Settings -> API Keys -> a "secret" key (sb_secret_...), or
# the legacy "service_role" JWT under the Legacy API Keys tab.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Optional: notification emails ───────────────────────────────────────────

# Shared secret between Supabase's Database Webhook and our
# /api/hooks/notification-email route. Any long random string; generate one:
#   openssl rand -hex 32
# Set the SAME value in Supabase → Database → Webhooks → (the webhook) →
# HTTP Headers → x-webhook-secret. Without it the route refuses everything
# (401), which is the safe failure. See SETUP.md §9.
# NOTIFICATION_WEBHOOK_SECRET=

# ── Optional: email (the app runs 100% fine without these) ──────────────────

# Resend API key (resend.com). When absent, all email sending silently
# no-ops and the app runs on in-app notifications alone.
# RESEND_API_KEY=re_...

# The From address for outgoing mail. Must be a domain verified in Resend.
# EMAIL_FROM="Study Buddies <hello@yourdomain.com>"

# Where user reports get emailed for team review. In-app storage happens
# regardless; this is just the heads-up email.
# ADMIN_EMAIL=team-inbox@example.com

# ── Note on Google SSO ──────────────────────────────────────────────────────
# Google OAuth credentials are configured in the SUPABASE DASHBOARD
# (Authentication → Providers → Google), not here. See SETUP.md §4.

# ── Email (optional) ──────────────────────────────────────────────────
# Every email in this app is best-effort: with these unset, sendEmail()
# is a silent no-op and nothing breaks — you just get in-app
# notifications only.
RESEND_API_KEY=
EMAIL_FROM=
# Where "a student filed a report" notices go.
ADMIN_EMAIL=

# Shared secret for the two server-to-server hooks:
#   - the Supabase database webhook that sends notification emails
#   - the scheduled group-chat digest (see docs/SCHEDULED_JOBS.md)
# Both refuse to run without it. Generate one with: openssl rand -hex 32
NOTIFICATION_WEBHOOK_SECRET=
